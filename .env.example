# Copy this file to .env and fill in your own values.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=seismic_db

# Data pull window (YYYY-MM-DD). Leave blank to default to "last 5 years to today".
START_DATE=
END_DATE=

# Minimum earthquake magnitude to fetch from USGS.
MIN_MAGNITUDE=4.5
